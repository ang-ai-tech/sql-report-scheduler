# Copy to .env to send real e-mails or to use your own databases.
# With docker compose the demo uses Mailpit and needs nothing here.

# SMTP server
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@example.com

# Time zone of the schedules
REPORTS_TIMEZONE=Europe/Rome

# Database credentials used in config/connections.yml as ${VARIABLE}
MSSQL_USER=
MSSQL_PASSWORD=
